---
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import CaseHeader from '../components/CaseHeader.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Contact from '../components/Contact.astro';
import { site } from '../site';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { id, data } = project;
// §9.4: "<title> — Rajdeep Singh Gaur", description from the entry, canonical + og:url, og:type article.
const title = `${data.title} — Rajdeep Singh Gaur`;
const canonical = `${site.url}/projects/${id}/`;
---

<Base title={title} description={data.description} canonical={canonical} ogType="article" navMode="project">
  <CaseHeader project={project} />

  <article class="container case-study">
    <div class="column">
      <SectionLabel>CASE STUDY</SectionLabel>
      <h2>{data.caseStudyTitle}</h2>
      <div class="case-body">
        <slot />
      </div>
    </div>
  </article>

  <div class="container back-bottom">
    <div class="back-box">
      <a href="/#projects"><span aria-hidden="true">←</span> Back to projects</a>
    </div>
  </div>

  <Contact label="CONTACT" />
</Base>

<style>
  .case-study { padding-block: 24px; }
  .column { max-width: 70ch; }

  h2 {
    margin-top: 12px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(34px, 4vw, 48px);
    line-height: 1.05;
  }

  /* ---------- Write-up body (MDX), from the artboard (§4.2.4) ---------- */
  .case-body {
    font-size: 17px;
    line-height: 1.6;
  }
  /* Paragraphs 16px apart; the body starts 32px below the h2. Zero specificity, so components'
     own spacing (TESTED box, Section label, figures) always wins. */
  :where(.case-body) :global(:where(p, ul, hr)) { margin: 16px 0 0; }
  .case-body > :global(p:first-child) { margin-top: 32px; }
  /* 20px after a heading, figure or list */
  .case-body :global(.case-section-head + p),
  .case-body :global(figure + p),
  .case-body :global(ul + p) { margin-top: 20px; }
  .case-body :global(table + p) { margin-top: 24px; }
  .case-body :global(strong) { font-weight: 600; }
  /* 44px hit area for links in running text (§7), as on the certificate link: an invisible
     ::after widens the tap target without changing line spacing, text size or the focus ring. */
  .case-body :global(p > a) { position: relative; }
  .case-body :global(p > a::after) {
    content: '';
    position: absolute;
    inset: -11px 0;
  }

  /* Bullet lists: 7px square accent marker (decorative), 14px between items */
  .case-body :global(ul) {
    margin-top: 20px;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .case-body :global(li) {
    position: relative;
    padding-left: 19px;
  }
  .case-body :global(li::before) {
    content: '';
    position: absolute;
    left: 0;
    top: 10px;
    width: 7px;
    height: 7px;
    background: var(--accent);
  }

  /* Dashed rule before the closing paragraph */
  .case-body :global(hr) {
    margin-top: 48px;
    border: 0;
    border-top: 1px dashed var(--border-dashed);
  }
  .case-body :global(hr + p) { margin-top: 24px; }

  /* ---------- Bottom back link ---------- */
  /* The artboard has 72px between this block and the Contact band; Contact.astro brings its own
     72px top margin (unchanged from the homepage), so the block itself has no bottom padding. */
  .back-bottom { padding-block: 56px 0; }
  .back-box {
    border-top: 2px solid var(--ink);
    border-bottom: 1px solid var(--border);
  }
  .back-box a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 24px 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 28px;
    line-height: 1.1;
    text-decoration: none;
  }
</style>

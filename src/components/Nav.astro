---
interface Props {
  /**
   * home: in-page anchors, wordmark → #top.
   * project (§4.2.3): section links point back to the homepage, Projects is current,
   *   Contact goes to the page's own Contact band.
   * other (404): section links and Contact point back to the homepage.
   */
  mode?: 'home' | 'project' | 'other';
}

const { mode = 'home' } = Astro.props;
const base = mode === 'home' ? '' : '/';
const links = [
  { label: 'Method', href: `${base}#method` },
  { label: 'Projects', href: `${base}#projects`, current: mode === 'project' },
  { label: 'Experience', href: `${base}#experience` },
];
// Contact is the button-styled last item (§6, D4).
const contact = { label: 'Contact', href: mode === 'other' ? '/#contact' : '#contact' };
const home = mode === 'home' ? '#top' : '/';
---

<header id="top" class="site-header">
  <nav aria-label="Primary" class="container nav">
    <a class="wordmark" href={home}>rajdeepgaur<span>.tech</span></a>

    <ul class="links only-desktop" role="list">
      {links.map((l) => <li><a href={l.href} aria-current={l.current ? 'true' : undefined}>{l.label}</a></li>)}
      <li><a class="cta" href={contact.href}>{contact.label}</a></li>
    </ul>

    <details class="menu only-mobile">
      <summary aria-label="Menu">
        <svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16"></path><path d="M4 12h16"></path><path d="M4 17h16"></path></svg>
      </summary>
      <ul class="panel" role="list">
        {links.map((l) => <li><a href={l.href} aria-current={l.current ? 'true' : undefined}>{l.label}</a></li>)}
        <li><a class="cta" href={contact.href}>{contact.label}</a></li>
      </ul>
    </details>
  </nav>
</header>

<style>
  .site-header {
    position: relative;
    border-bottom: 1px solid var(--border);
  }

  /* Mobile (canvas: Mobile.dc.html header) */
  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 8px;
  }

  .wordmark {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .wordmark span { color: var(--accent); }

  .menu summary {
    width: 44px;
    height: 44px;
    border: 1px solid var(--ink);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink);
    cursor: pointer;
    list-style: none;
  }
  .menu summary::-webkit-details-marker { display: none; }
  .menu summary::marker { content: ''; }

  .panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 10;
    margin: 0;
    padding: 8px var(--gutter) 20px;
    background: var(--page);
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 14px;
  }
  .panel li + li { border-top: 1px solid var(--border-soft); }
  .panel a {
    display: flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }
  .panel .cta { margin-top: 12px; justify-content: center; }

  .cta {
    background: var(--ink);
    color: var(--card);
    text-decoration: none;
    padding: 10px 16px;
    border-radius: var(--radius);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .cta:hover { color: var(--card); }

  /* Project pages: Projects in accent (Project-page.dc.html) */
  [aria-current='true'] { color: var(--accent); }

  /* Desktop (canvas: Main.dc.html nav) */
  @media (min-width: 640px) {
    .nav { padding-block: 18px; }
    .wordmark { font-size: 15px; letter-spacing: 0.02em; }

    .links {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 28px;
      margin: 0;
      font-family: var(--font-mono);
      font-size: 14px;
    }
    .links a:not(.cta) {
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }
</style>

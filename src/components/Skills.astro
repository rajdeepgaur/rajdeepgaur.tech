---
import SectionLabel from './SectionLabel.astro';

const skills = [
  { name: 'Customer support', items: 'Ticket triage (product defect vs configuration vs expected behavior) and escalation · helpdesk ticketing · documentation · customer feedback to the product team · cross-team collaboration' },
  { name: 'Troubleshooting', items: 'Root-cause debugging on customer sites (FTP, cPanel) · log analysis (Grafana Loki, debug and server error logs) · backup, restore and migration issues · plugin and theme compatibility testing' },
  { name: 'WordPress', items: 'Custom themes and plugins · FSE / block themes · Gutenberg · Elementor · Multisite · custom post types and custom fields · WP All Import' },
  { name: 'Performance, SEO and security', items: 'Core Web Vitals · caching plugins · Yoast · Rank Math · Google Analytics · malware investigation and cleanup · security hardening' },
  { name: 'Web development', items: 'HTML · CSS · JavaScript · React · Next.js · responsive design · accessibility · Node.js · REST APIs · authentication · PostgreSQL · MySQL · Python' },
  { name: 'AI and LLMs', items: 'LLM API integration with structured JSON output · MCP · RAG · AI-assisted development' },
  { name: 'Hosting and tools', items: 'cPanel · FTP · SSH · Git and Git deploy workflows · GitHub · Grafana Loki · browser DevTools' },
];
---

<section class="container skills-certs">
  <div class="skills">
    <SectionLabel>04 / SKILLS</SectionLabel>
    <h2>Toolkit</h2>
    <dl class="rule">
      {
        skills.map((s) => (
          <div class="row">
            <dt>{s.name}</dt>
            <dd>{s.items}</dd>
          </div>
        ))
      }
    </dl>
  </div>
  <div class="certs">
    <SectionLabel>05 / CERTIFICATIONS</SectionLabel>
    <h2>Certifications</h2>
    <ol class="rule" role="list">
      <li>
        <p class="cert"><a href="https://courses.chaicode.com/learn/certificate/14349312-270594" target="_blank" rel="noopener">GenAI with JavaScript{' '}<span aria-hidden="true">↗</span><span class="visually-hidden">(opens in new tab)</span></a></p>
        <p class="issuer">ChaiCode · Sep 2026</p>
      </li>
    </ol>
  </div>
</section>

<style>
  .skills-certs {
    padding-block: 72px 40px;
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
  }
  .skills { flex: 999 1 600px; min-width: 0; }
  .certs { flex: 1 1 300px; min-width: 0; }

  h2 {
    margin: 10px 0 24px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 40px;
    line-height: 1.05;
  }

  .rule { margin: 0; border-top: 2px solid var(--ink); }

  /* Below 640px (not in the canvas) the name sits above its list; from 640px the canvas grid applies. */
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 4px;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
  }
  @media (min-width: 640px) {
    .row {
      grid-template-columns: minmax(140px, 200px) minmax(0, 1fr);
      gap: 16px;
    }
  }
  dt {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 600;
  }

  .certs li { padding: 14px 0; border-bottom: 1px solid var(--border); }
  .cert { font-weight: 600; }
  /* 44px hit area (§7) without changing the row's spacing or enlarging the focus ring:
     the extra area is an invisible pseudo-element around the text. */
  .cert a {
    position: relative;
    display: inline-block;
  }
  .cert a::after {
    content: '';
    position: absolute;
    inset: -9px 0;
  }
  .issuer {
    margin-top: 2px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
  }
</style>

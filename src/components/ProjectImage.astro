---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  bg: string;
  fit: 'contain' | 'cover';
  /** Below 640px only; unset = same as fit (§6, §8). */
  fitMobile?: 'contain' | 'cover';
}

const { src, alt, bg, fit, fitMobile } = Astro.props;
// Decided 22 Nov: one full-size lossless WebP per screenshot, pixel-identical to the original PNG
// (lossless/exact options are in astro.config.mjs). Full size keeps UI text sharp when zoomed in.
// Built-in loading="lazy" only; trade-offs (full-size download on phones) accepted.
// Earlier tries: AVIF/WebP at quality 90 and 100 (blurred when zoomed, capped at 1200w),
// the raw PNGs (sharp but ~987 KB), lossless AVIF (heavier than the PNGs).
---

<div class:list={['box', fit, fitMobile && `mobile-${fitMobile}`]} style={`background: ${bg}`}>
  <Image
    src={src}
    alt={alt}
    format="webp"
    width={src.width}
    height={src.height}
    loading="lazy"
    decoding="async"
  />
</div>

<style>
  .box {
    height: 280px;
    width: 100%;
    border-bottom: 1px solid var(--border-soft);
    overflow: hidden;
  }
  .box :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  /* Alpha: cover, anchored to the top (§6) */
  .cover :global(img) {
    object-fit: cover;
    object-position: top;
  }
  /* fitMobile replaces fit below 640px, centred (1% Better: cover on phones, contain from 640px) */
  @media (max-width: 639.98px) {
    .mobile-cover :global(img) {
      object-fit: cover;
      object-position: center;
    }
    .mobile-contain :global(img) {
      object-fit: contain;
      object-position: center;
    }
  }
</style>

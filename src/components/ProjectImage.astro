---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  bg: string;
  fit: 'contain' | 'cover';
  /** Below 640px only; unset = same as fit (§6, §8). */
  fitMobile?: 'contain' | 'cover';
  /** CSS object-position; unset = centre. */
  position?: string;
  /** Below 640px only; unset = same as position. */
  positionMobile?: string;
}

const { src, alt, bg, fit, fitMobile, position, positionMobile } = Astro.props;
// Decided 22 Nov: one full-size lossless WebP per screenshot, pixel-identical to the original PNG
// (lossless/exact options are in astro.config.mjs). Full size keeps UI text sharp when zoomed in.
// Built-in loading="lazy" only; trade-offs (full-size download on phones) accepted.
// Earlier tries: AVIF/WebP at quality 90 and 100 (blurred when zoomed, capped at 1200w),
// the raw PNGs (sharp but ~987 KB), lossless AVIF (heavier than the PNGs).
//
// Fit and position come from the data as custom properties; the mobile ones fall back to the
// desktop ones below 640px. Alpha: cover + top. Block Rewind: cover + top, right top on phones.
// 1% Better: contain, cover (centred) on phones.
const vars = [
  `background: ${bg}`,
  `--fit: ${fit}`,
  position && `--pos: ${position}`,
  fitMobile && `--fit-m: ${fitMobile}`,
  positionMobile && `--pos-m: ${positionMobile}`,
].filter(Boolean).join('; ');
---

<div class="box" style={vars}>
  <Image
    src={src}
    alt={alt}
    format="webp"
    width={src.width}
    height={src.height}
    loading="lazy"
    decoding="async"
  />
</div>

<style>
  .box {
    height: 280px;
    width: 100%;
    border-bottom: 1px solid var(--border-soft);
    overflow: hidden;
  }
  .box :global(img) {
    width: 100%;
    height: 100%;
    object-fit: var(--fit, contain);
    object-position: var(--pos, center);
  }
  @media (max-width: 639.98px) {
    .box :global(img) {
      object-fit: var(--fit-m, var(--fit, contain));
      object-position: var(--pos-m, var(--pos, center));
    }
  }
</style>

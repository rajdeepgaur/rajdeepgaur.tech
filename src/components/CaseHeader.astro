---
import type { CollectionEntry } from 'astro:content';
import CaseFile from './CaseFile.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data } = project;
---

<section class="container case-header">
  <div class="back-row">
    <a class="back" href="/#projects">
      <svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"></path><path d="m11 6-6 6 6 6"></path></svg>Back to projects
    </a>
  </div>

  <div class="columns">
    <div class="main">
      <div class="strip">
        <span>{data.caseLabel}</span>
        <span class="status"><span class="dot" aria-hidden="true"></span>{data.status}</span>
      </div>
      <h1>{data.title}</h1>
      <dl>
        <dt>PROBLEM</dt><dd>{data.problem}</dd>
        <dt>BUILT</dt><dd>{data.built}</dd>
      </dl>
    </div>
    <CaseFile project={project} />
  </div>
</section>

<style>
  /* The project page artboard sets line-height 1.6 on the whole page */
  .case-header {
    padding-block: 32px 56px;
    line-height: 1.6;
  }

  .back-row {
    padding-bottom: 18px;
    border-bottom: 1px dashed var(--border-dashed);
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
  }
  .back:hover { color: var(--muted); }

  .columns {
    margin-top: 40px;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 48px 56px;
  }
  .main {
    flex: 999 1 560px;
    min-width: 0;
  }

  .strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 20px;
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--live);
    font-weight: 600;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--live);
  }

  h1 {
    margin-top: 14px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(56px, 7vw, 96px);
    line-height: 0.95;
    letter-spacing: -0.02em;
  }

  dl {
    margin-top: 32px;
    max-width: 70ch;
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 14px 20px;
    border-top: 2px solid var(--ink);
    padding-top: 20px;
  }
  dt {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
    padding-top: 4px;
  }
  dd {
    font-size: 19px;
    line-height: 1.5;
  }
</style>

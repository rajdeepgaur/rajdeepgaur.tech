---
import EvidenceLedger from './EvidenceLedger.astro';
---

<section class="container hero">
  <div class="status">
    <span class="only-desktop">Case log / 2018 – 2026</span>
    <span class="open"><span class="dot" aria-hidden="true"></span>Open to work · Rajasthan, India · Remote or relocation</span>
  </div>

  <div class="grid">
    <div class="intro">
      <p class="name">Rajdeep Singh Gaur</p>
      <h1>A support engineer who builds.</h1>
      <p class="sub only-desktop">I've resolved 1,500+ support tickets <em>and</em> built 100+ production WordPress sites, so I understand problems from both the customer's side and the code's side.</p>
      <p class="sub only-mobile">1,500+ tickets resolved and 100+ WordPress sites built: problems from the customer's side and the code's side.</p>
    </div>

    <div class="evidence">
      <EvidenceLedger />
    </div>

    <div class="ctas">
      <a class="btn primary" href="#projects">See projects</a>
      <a class="btn secondary" href="#contact">Get in touch</a>
    </div>
  </div>
</section>

<style>
  /* Mobile first (Mobile.dc.html) */
  .hero { padding-top: 20px; padding-bottom: 40px; }

  .status {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    font-family: var(--font-mono);
    font-size: 12px; /* canvas 11px, raised per §5.3 */
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .open {
    display: inline-flex;
    align-items: flex-start;
    gap: 6px;
    color: var(--live);
    font-weight: 600;
  }
  /* Dot sits on the first line when the status text wraps (line-height 1.55 → half-line is 0.775em). */
  .dot {
    flex: 0 0 auto;
    width: 8px;
    height: 8px;
    margin-top: calc(0.775em - 4px);
    border-radius: 50%;
    background: var(--live);
  }

  /* DOM order is intro → ledger → CTAs (mobile order). Grid areas reorder for wider screens. */
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'intro' 'evidence' 'ctas';
    gap: 18px;
    margin-top: 18px;
  }
  .intro { grid-area: intro; min-width: 0; }
  .evidence { grid-area: evidence; min-width: 0; }
  .ctas { grid-area: ctas; }

  .name { font-size: 17px; font-weight: 600; }
  h1 {
    margin-top: 8px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(44px, 6.5vw, 88px);
    line-height: 0.95;
    letter-spacing: -0.02em;
  }
  .sub {
    margin-top: 10px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--body-2);
  }

  .ctas {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .btn {
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius);
  }
  .primary { background: var(--accent); color: #FFFFFF; }
  .primary:hover { color: #FFFFFF; }
  .secondary { border: 1.5px solid var(--ink); }

  /* Desktop (Main.dc.html) */
  @media (min-width: 640px) {
    .hero { padding-top: 56px; padding-bottom: 72px; }

    .status {
      gap: 10px 28px;
      font-size: 13px;
      letter-spacing: 0.06em;
      padding-bottom: 20px;
      border-bottom: 1px dashed var(--border-dashed);
    }
    .open { gap: 8px; font-weight: 400; }
    .dot { width: 9px; height: 9px; margin-top: calc(0.775em - 4.5px); }

    .grid {
      grid-template-areas: 'intro' 'ctas' 'evidence';
      gap: 0;
      margin-top: 40px;
    }
    .ctas { margin-top: 32px; }
    .evidence { margin-top: 56px; }

    .name { font-size: 20px; }
    h1 { margin-top: 12px; }
    .sub {
      margin-top: 16px;
      max-width: 600px;
      font-size: 18px;
      line-height: 1.55;
    }

    .ctas {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 12px;
    }
    .btn {
      display: inline-flex;
      padding: 14px 22px;
    }
  }

  /* Two columns from 960px (§5.4): intro + CTAs left, ledger right */
  @media (min-width: 960px) {
    .grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 380px);
      grid-template-areas: 'intro evidence' 'ctas evidence';
      grid-template-rows: auto 1fr;
      column-gap: 56px;
      align-items: start;
    }
    .evidence { margin-top: 0; }
  }
</style>

---
interface Row {
  decision: string;
  benefit: string;
  cost: string;
}

interface Props {
  rows: Row[];
}

const { rows } = Astro.props;
// §4.2.4: a real table; no scroll wrapper and no min-width at any width. Below 640px each row
// stacks, with BENEFIT/COST labels from data-label. Changing a table's display drops its table
// meaning in some browsers (Safari), so the roles are set explicitly. Header words are the
// write-up's ("Decision", "Benefit", "Cost"), set in capitals by CSS as on the artboard.
---

<table class="tradeoffs" role="table">
  <thead role="rowgroup">
    <tr role="row">
      <th scope="col" role="columnheader">Decision</th>
      <th scope="col" role="columnheader">Benefit</th>
      <th scope="col" role="columnheader">Cost</th>
    </tr>
  </thead>
  <tbody role="rowgroup">
    {
      rows.map((r) => (
        <tr role="row">
          <td role="cell">{r.decision}</td>
          <td role="cell" data-label="Benefit">{r.benefit}</td>
          <td role="cell" data-label="Cost">{r.cost}</td>
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  .tradeoffs {
    margin-top: 24px;
    width: 100%;
    border-collapse: collapse;
    border-top: 2px solid var(--ink);
  }

  /* From 640px: a normal table */
  th {
    text-align: left;
    padding: 12px 14px 12px 0;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--ink);
  }
  td {
    padding: 14px 14px 14px 0;
    vertical-align: top;
    border-bottom: 1px solid var(--border);
    font-size: 16px;
  }
  td:first-child { font-weight: 600; }

  /* Below 640px: each row stacks; the header row is hidden visually but still read */
  @media (max-width: 639.98px) {
    thead {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
    .tradeoffs,
    tbody,
    tr,
    td { display: block; }
    tr {
      padding: 16px 0;
      border-bottom: 1px solid var(--border);
    }
    td {
      padding: 0;
      border: 0;
    }
    td:first-child { margin-bottom: 10px; }
    td + td { margin-top: 8px; }
    td[data-label] {
      display: grid;
      grid-template-columns: 64px minmax(0, 1fr);
      gap: 12px;
    }
    td[data-label]::before {
      content: attr(data-label);
      font-family: var(--font-mono);
      font-size: 12px;
      font-weight: 400;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--muted);
      padding-top: 3px;
    }
  }
</style>

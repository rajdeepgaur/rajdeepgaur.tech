---
import Diagram from '../diagram/Diagram.astro';
import DiagramBox from '../diagram/DiagramBox.astro';
import DiagramArrow from '../diagram/DiagramArrow.astro';

// From Project-page.dc.html (§4.2.4). Label: the artboard's aria-label, exactly.
const label =
  'Edits flow from the block editor through a quick check, block identification and the edited-blocks queue into saved versions in IndexedDB. The sidebar reads versions back for compare and restore; restoring saves the current state first. Expiry cleanup runs every 5 minutes.';
const caption = 'Block Rewind architecture · editor to storage and back';
// Wide (≥ 820px): a closed loop. Small (< 820px): a vertical loop with a return line in the left gutter.
---

<Diagram label={label} caption={caption} breakpoint={820}>
  <div slot="wide" class="wide">
    <div class="wide-top">
      <DiagramBox name="Block editor" sub="your blocks" />
      <DiagramArrow dir="right" />
      <DiagramBox name="Quick check" sub="on change, max 5 per s" />
      <DiagramArrow dir="right" />
      <DiagramBox name="Identify + compare" sub="which block, what changed" highlight />
      <DiagramArrow dir="right" />
      <DiagramBox name="Edited blocks" sub="waiting to be saved" />
      <DiagramArrow dir="up" align="start" class="restore"><strong>restore</strong><br />current state saved first</DiagramArrow>
      <DiagramArrow dir="down" align="end" labelFirst class="checked">checked every 5 s</DiagramArrow>
    </div>
    <div class="wide-bottom">
      <DiagramBox name="Sidebar + compare" sub="history list and diff" />
      <DiagramArrow dir="left" />
      <DiagramBox name="IndexedDB" sub="in the browser" highlight />
      <DiagramArrow dir="left" />
      <DiagramBox name="Save versions" sub="once a minute, and on exit" />
      <DiagramArrow dir="up" class="cleanup-arrow" />
      <DiagramBox name="Expiry cleanup" sub="every 5 min, in chunks" class="cleanup-box" />
    </div>
  </div>

  <div slot="small" class="small">
    <div class="ret-in" aria-hidden="true">
      <span class="v"></span><span class="h"></span>
      <svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="m14 6 6 6-6 6"></path></svg>
    </div>
    <div class="ret-gutter" aria-hidden="true"><span class="v"></span></div>
    <div class="ret-out" aria-hidden="true"><span class="v"></span><span class="h"></span></div>

    <div class="cell r1"><DiagramBox name="Block editor" sub="your blocks" /></div>
    <div class="cell r2"><DiagramArrow dir="down" class="step" /></div>
    <div class="cell r3"><DiagramBox name="Quick check" sub="on change, max 5 per s" /></div>
    <div class="cell r4"><DiagramArrow dir="down" class="step" /></div>
    <div class="cell r5"><DiagramBox name="Identify + compare" sub="which block, what changed" highlight /></div>
    <div class="cell r6"><DiagramArrow dir="down" class="step" /></div>
    <div class="cell r7"><DiagramBox name="Edited blocks" sub="waiting to be saved" /></div>
    <div class="cell r8"><DiagramArrow dir="down" class="step">checked every 5 s</DiagramArrow></div>
    <div class="cell r9"><DiagramBox name="Save versions" sub="once a minute, and on exit" /></div>
    <div class="cell r10"><DiagramArrow dir="down" class="step" /></div>
    <div class="cell r11">
      <div class="db-row">
        <DiagramBox name="IndexedDB" sub="in the browser" highlight class="db">
          <span class="cleanup-inline">Expiry cleanup<br />every 5 min, in chunks</span>
        </DiagramBox>
        <div class="cleanup-branch">
          <span class="branch-line" aria-hidden="true"></span>
          <span class="branch-box">Expiry cleanup<br /><span class="branch-sub">every 5 min, in chunks</span></span>
        </div>
      </div>
    </div>
    <div class="cell r12"><DiagramArrow dir="down" class="step" /></div>
    <div class="cell r13"><DiagramBox name="Sidebar + compare" sub="history list and diff" /></div>
    <p class="restore-note"><strong>restore</strong> · current state saved first</p>
  </div>
</Diagram>

<style>
  /* Shared stroke for lines drawn in CSS: 1.75px --muted, as the kit's arrows */
  .small { --stroke: 1.75px solid var(--muted); }

  /* ---------- Wide ---------- */
  .wide-top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 32px minmax(0, 1fr) 32px minmax(0, 1fr) 32px minmax(0, 1fr);
    grid-template-rows: auto 56px;
  }
  /* Row 2: up arrow on the left (restore), down arrow on the right (checked every 5 s).
     Each spans three columns so its label has room; the arrows stay at the outer edges. */
  .wide-top :global(.restore) { grid-row: 2; grid-column: 1 / 4; }
  .wide-top :global(.checked) { grid-row: 2; grid-column: 5 / 8; }

  .wide-bottom {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 32px minmax(0, 1fr) 32px minmax(0, 1fr);
    grid-template-rows: auto 40px auto;
  }
  .wide-bottom :global(.cleanup-arrow) { grid-row: 2; grid-column: 3; }
  .wide-bottom :global(.cleanup-box) { grid-row: 3; grid-column: 3; }

  /* ---------- Small ---------- */
  .small {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
  }
  .cell { grid-column: 2; min-width: 0; }
  .r1 { grid-row: 1; } .r2 { grid-row: 2; } .r3 { grid-row: 3; } .r4 { grid-row: 4; }
  .r5 { grid-row: 5; } .r6 { grid-row: 6; } .r7 { grid-row: 7; } .r8 { grid-row: 8; }
  .r9 { grid-row: 9; } .r10 { grid-row: 10; } .r11 { grid-row: 11; } .r12 { grid-row: 12; }
  .r13 { grid-row: 13; }
  .small :global(.step) { padding: 6px 0; }

  /* Return path: out of the bottom of Sidebar + compare, left to the gutter, up the gutter,
     and into Block editor with the chevron. */
  .ret-in, .ret-gutter, .ret-out { position: relative; }
  .ret-in { grid-column: 1; grid-row: 1; }
  .ret-in .v { position: absolute; left: 9px; top: 50%; bottom: 0; border-left: var(--stroke); }
  .ret-in .h { position: absolute; left: 9px; right: 1px; top: 50%; border-top: var(--stroke); }
  .ret-in svg { position: absolute; right: -1px; top: 50%; transform: translateY(-50%); color: var(--muted); }
  .ret-gutter { grid-column: 1; grid-row: 2 / 15; }
  .ret-gutter .v { position: absolute; left: 9px; top: 0; bottom: 0; border-left: var(--stroke); }
  .ret-out { grid-column: 1 / 3; grid-row: 14; height: 16px; }
  .ret-out .v { position: absolute; left: calc(24px + (100% - 24px) / 2); top: 0; bottom: 0; border-left: var(--stroke); }
  .ret-out .h { position: absolute; left: 9px; width: calc(24px + (100% - 24px) / 2 - 9px); bottom: 0; border-top: var(--stroke); }

  .restore-note {
    grid-column: 1 / 3;
    grid-row: 15;
    margin: 8px 0 0;
    padding-left: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.4;
    color: var(--muted);
  }
  .restore-note strong { font-weight: 600; }

  /* IndexedDB with Expiry cleanup branching right; below 480px it folds into the box */
  .db-row { display: flex; align-items: center; }
  .db-row :global(.db) { flex: 1 1 auto; }
  .cleanup-branch { flex: 0 1 150px; min-width: 0; display: flex; align-items: center; }
  .branch-line { flex: 0 0 14px; height: 0; border-top: var(--stroke); }
  .branch-box {
    flex: 1 1 auto;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.35;
    color: var(--ink);
    background: var(--card);
    border: 1px solid var(--ink);
    padding: 6px 8px;
  }
  .branch-sub { color: var(--muted); }
  .cleanup-inline { display: none; }
  @media (max-width: 479.98px) {
    .cleanup-branch { display: none; }
    .cleanup-inline {
      display: block;
      margin-top: 8px;
      padding-top: 8px;
      border-top: 1px solid var(--border);
      font-family: var(--font-mono);
      font-size: 12px;
      line-height: 1.35;
      color: var(--muted);
    }
  }
</style>

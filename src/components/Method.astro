---
import SectionLabel from './SectionLabel.astro';

const triage = [
  {
    label: 'A · PRODUCT DEFECT',
    title: 'Reproduce it, document it, escalate it.',
    body: 'Engineering gets a clear case, not a forwarded complaint.',
  },
  {
    label: 'B · CONFIGURATION',
    title: "Fix it on the customer's site.",
    body: 'Working directly on servers via FTP, cPanel and, occasionally, SSH.',
  },
  {
    label: 'C · EXPECTED BEHAVIOR',
    title: 'Explain it, then feed it back.',
    body: 'The customer gets a clear answer; the product team gets the feedback.',
  },
];

const steps = [
  {
    title: 'Find the real cause',
    body: "Alpha's sign-in kept needing workarounds for the Chrome extension. The cause: Neon's managed auth has no path for cookie-less clients. Self-hosted Better Auth with its Bearer plugin removed the workarounds.",
  },
  {
    title: 'Test before building',
    body: 'Before turning Chart Lookalikes into a prediction product, I ran a walk-forward test on 3,000 dates against a random baseline. No reliable edge, so it became an exploration tool.',
  },
  {
    title: 'Ship with honest limits',
    body: "Block Rewind passed WordPress.org review and lists what it doesn't do. Alpha gives a descriptive bias with both scenarios, not buy/sell calls.",
  },
];
---

<section id="method" class="method">
  <div class="container inner">
    <SectionLabel tone="on-dark">01 / METHOD</SectionLabel>
    <h2 class="section-title">Diagnose first. Then fix, build or escalate.</h2>

    <div class="row-head support-head">
      <h3>WHEN I SUPPORT</h3>
      <p>1,500+ tickets across BlogVault, MalCare, Migrate Guru and WP Remote.</p>
    </div>
    <div class="support">
      <div class="intake">
        <div class="box input">
          <p class="kicker">INPUT</p>
          <p class="box-title">A customer's problem</p>
          <p class="box-body">Ticket, bug report or "my site is broken".</p>
        </div>
        <div class="box classify">
          <p class="kicker">CLASSIFY</p>
          <p class="box-title">What kind of problem is this?</p>
        </div>
      </div>
      <div class="arrow" aria-hidden="true">
        <svg aria-hidden="true" focusable="false" width="40" height="24" viewBox="0 0 40 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M0 12h36"></path><path d="m28 4 8 8-8 8"></path></svg>
      </div>
      <ol class="triage" role="list">
        {
          triage.map((t) => (
            <li>
              <p class="kicker">{t.label}</p>
              <p class="t-title">{t.title}</p>
              <p class="t-body">{t.body}</p>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="row-head build-head">
      <h3>WHEN I BUILD</h3>
      <p>3 live apps and a plugin on WordPress.org.</p>
    </div>
    <ol class="steps" role="list">
      {
        steps.map((s, i) => (
          <li>
            <span class="num">{i + 1}</span>
            <div>
              <p class="s-title">{s.title}</p>
              <p class="s-body">{s.body}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <p class="closing">Same habit on both sides: find the real problem first.</p>
  </div>
</section>

<style>
  .method {
    background: var(--dark);
    color: var(--on-dark);
  }
  .method :global(:focus-visible) { outline-color: var(--accent-on-dark); }
  .inner { padding-block: 80px; }

  .row-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 32px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--dark-rule);
  }
  .support-head { margin-top: 48px; }
  .build-head { margin-top: 64px; }
  .row-head h3 {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--on-dark);
  }
  .row-head p { font-size: 15px; color: var(--dark-text); }

  .kicker {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--dark-label);
  }

  .support {
    margin-top: 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 24px;
  }
  .intake {
    flex: 1 1 240px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .box { padding: 20px; }
  .input { border: 1px solid var(--dark-border); }
  .classify { border: 1px solid var(--accent-on-dark); }
  .classify .kicker { color: var(--accent-on-dark); }
  .box-title { margin-top: 6px; font-size: 20px; font-weight: 600; }
  .box-body { margin-top: 6px; color: var(--dark-text); font-size: 15px; }

  .arrow {
    display: none;
    flex: 0 0 auto;
    align-items: center;
    color: var(--accent-on-dark);
  }
  @media (min-width: 960px) {
    .arrow { display: flex; }
  }

  .triage {
    margin: 0;
    flex: 3 1 600px;
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 16px;
  }
  .triage li {
    background: var(--dark-card);
    border-top: 3px solid var(--accent-on-dark);
    padding: 22px;
  }
  .t-title { margin-top: 10px; font-size: 18px; font-weight: 600; }
  .t-body { margin-top: 8px; color: var(--dark-text); font-size: 15px; }

  /* 1px gaps on a border-coloured background draw the dividers (§6) */
  .steps {
    margin: 24px 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    border: 1px solid var(--dark-border);
    gap: 1px;
    background: var(--dark-border);
  }
  .steps li {
    padding: 22px 24px;
    background: var(--dark);
    display: flex;
    gap: 16px;
  }
  .num {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent-on-dark);
    padding-top: 4px;
  }
  .s-title { font-size: 18px; font-weight: 600; }
  .s-body { margin-top: 6px; color: var(--dark-text); font-size: 15px; }

  .closing {
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px dashed var(--dark-border);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 24px;
    color: var(--on-dark);
  }
</style>
